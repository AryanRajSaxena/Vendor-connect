# Cashfree Payment Gateway Configuration
# Copy this file to .env.local and fill in your actual values

# ============================================
# CASHFREE API CREDENTIALS (REQUIRED)
# ============================================
# Get these from: https://dashboard.cashfree.com/settings/api-keys

# Your Cashfree App ID (found in dashboard)
CASHFREE_APP_ID=TEST11034045450dec73cfeb0d065dbc54043011

# Your Cashfree App Secret (KEEP THIS SECURE! Never commit to git)
CASHFREE_APP_SECRET=cfsk_ma_test_ac38ae9dfc0c4859af807c91e3300e7c_68980240

# ============================================
# PAYMENT GATEWAY URLs (REQUIRED)
# ============================================
# These URLs are where Cashfree redirects after payment

# URL where customer is redirected after payment attempt
# Development: http://localhost:3000/payment-return
# Production: https://yourdomain.com/payment-return
CASHFREE_RETURN_URL=http://localhost:3000/payment-return

# Webhook URL for payment notifications
# Development: http://yourdomain.ngrok.io/api/payments/webhook (use ngrok for testing)
# Production: https://yourdomain.com/api/payments/webhook
CASHFREE_NOTIFY_URL=https://yourdomain.com/api/payments/webhook

# ============================================
# ENVIRONMENT SETUP
# ============================================
# development: Uses Cashfree sandbox for testing
# production: Uses live Cashfree API
NODE_ENV=development

# ============================================
# SUPABASE CONFIGURATION (REQUIRED)
# ============================================
# Get these from: https://app.supabase.com → Settings → API
# 
# IMPORTANT: Without these, the app will fail with 500 errors!

# Your Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (used by browser/client code)
# - Can be exposed in frontend code
# - Used for public operations and user auth
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (KEEP SECRET! Only for backend)
# - NEVER expose in frontend code
# - Used by API routes to bypass RLS
# - Required for server-side operations
# - Set this in Vercel/production environment variables
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# NOTES
# ============================================
# 1. For local testing, you can use ngrok to expose your localhost:
#    ngrok http 3000
#    Then set CASHFREE_NOTIFY_URL=https://<your-ngrok-url>/api/payments/webhook
#
# 2. Test Card (Sandbox): 4111111111111111 | CVV: 123 | Exp: 12/25
#
# 3. After setting these variables, restart your Next.js dev server:
#    npm run dev
#
# 4. For production deployment on Netlify/Vercel:
#    - Add these variables in their deployment settings
#    - Do NOT include .env.local in git
